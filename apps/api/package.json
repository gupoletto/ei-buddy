    "@na-regua/env": "workspace:*",
    "@na-regua/money": "workspace:*",
    "bullmq": "^6.3.2",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
