# =============================================================================
# Ambiente de desenvolvimento local.
#
#   cp .env.example .env      (ou: pnpm setup, que faz isso e sobe a infra)
#
# NUNCA versione o .env. NUNCA use credencial de producao aqui (RNF-070).
# A matriz completa de variaveis esta em docs/engenharia/ambientes.md
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug
TZ=America/Sao_Paulo

# --- Infraestrutura local (casa com infra/docker-compose.yml) ---------------

POSTGRES_USER=naregua
POSTGRES_PASSWORD=naregua
POSTGRES_DB=naregua
POSTGRES_PORT=5432
REDIS_PORT=6379

# NAO e o POSTGRES_USER acima, e a diferenca e proposital: aquele e o dono do
# banco, e dono e superusuario — superusuario IGNORA a RLS, entao o isolamento
# entre empresas nao valeria. A api recusa subir se detectar isso.
DATABASE_URL=postgresql://naregua_app:naregua@localhost:5432/naregua
# Papel separado, com BYPASSRLS — so para migrations (docs/arquitetura/dados.md)
DATABASE_MIGRATION_URL=postgresql://naregua_migrator:naregua@localhost:5432/naregua
REDIS_URL=redis://localhost:6379

# --- Aplicacoes -------------------------------------------------------------

API_PORT=3333
API_URL=http://localhost:3333
WEB_PORT=3000

# --- Perfil "full" do docker compose ----------------------------------------

MINIO_USER=naregua
MINIO_PASSWORD=naregua123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# =============================================================================
# Provedores externos
#
# Todos ainda em decisao aberta — ver docs/decisoes/README.md
# Enquanto uma decisao nao fecha, o adapter roda em modo falso (fake) e o
# sistema funciona localmente sem credencial nenhuma.
# =============================================================================

# --- PSP: PagMaxx (DEC-006) — docs/arquitetura/integracoes/pagmaxx.md -------
PAYMENTS_PROVIDER=fake
PAGMAXX_BASE_URL=https://api.homolog.pagmaxx.com/api
PAGMAXX_API_KEY=
# Necessarios enquanto QST-009 nao for resolvida: Pix, links e assinaturas
# exigem JWT obtido com e-mail e senha da conta.
PAGMAXX_ACCOUNT_EMAIL=
PAGMAXX_ACCOUNT_PASSWORD=
PAGMAXX_WEBHOOK_SECRET=

# --- WhatsApp (DEC-003) -----------------------------------------------------
WHATSAPP_PROVIDER=fake
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# --- Fiscal (DEC-004) -------------------------------------------------------
FISCAL_PROVIDER=fake
FISCAL_API_TOKEN=
FISCAL_ENVIRONMENT=homologacao

# --- Open Finance (DEC-005) -------------------------------------------------
BANKING_PROVIDER=fake
BANKING_CLIENT_ID=
BANKING_CLIENT_SECRET=

# --- LLM (DEC-007) ----------------------------------------------------------
AGENT_PROVIDER=fake
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# --- Autenticacao (ADR-0002) ------------------------------------------------
#
# `fake` guarda a credencial em `.dev/identidades.json` com scrypt e serve ao
# desenvolvimento. `better-auth` e o provedor de verdade (opcao D da ADR): as
# tabelas dele ficam no schema `identidade`, criadas por
# `pnpm --filter @na-regua/api migrar:identidade` DEPOIS de `pnpm db:migrate`.
#
# Producao recusa subir com `fake` — ver `assertAuthUsavelEmProducao`.
AUTH_PROVIDER=fake
JWT_SECRET=dev-only-nao-use-em-producao-troque-isto

# Obrigatoria quando AUTH_PROVIDER=better-auth, e ignorada com `fake`.
# 32+ caracteres aleatorios:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# =============================================================================
# Webhooks em desenvolvimento
#
# Provedores exigem URL HTTPS publica — localhost e recusado no cadastro
# (vale para PagMaxx e para WhatsApp). Use um tunel:
#
#   cloudflared tunnel --url http://localhost:3333
#   ngrok http 3333
#
# e cadastre a URL gerada no portal do provedor.
# =============================================================================
PUBLIC_WEBHOOK_URL=

# Cifra os segredos de lojista guardados em coluna — RF-004, RNF-022.
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Obrigatoria apenas com FISCAL_PROVIDER=focusnfe.
SECRETS_KEY=

# De onde sai a nota fiscal — DEC-004. `fake` nao emite nada.
FISCAL_PROVIDER=fake
# Homologacao NAO tem validade fiscal.
FISCAL_AMBIENTE=homologacao
